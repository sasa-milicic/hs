{
  "name": "@hs/react-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:edeja": "vite --mode edeja",
    "dev:services": "vite --mode services",
    "dev:production": "vite --mode production",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
